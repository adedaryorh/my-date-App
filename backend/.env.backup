# Environment variables for Celebut Application

# Application Settings
APP_NAME=Celebut
APP_ENV=local
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
PORT=7070
GIN_MODE=debug

# Database Settings
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgrespassword
PG_DATABASE=celebut
PGSSLMODE=disable
PG_POOL_MAX=20

# Redis Settings
REDIS_URI=redis://redis:6379

# JWT Settings
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_SECRET_EXPIRY=24h

# Service Address
SERVICE_ADDRESS=http://localhost:7070

# AWS Settings (if using AWS services)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=celebut-bucket

# Third-party Services
SENDGRID_API_KEY=your-sendgrid-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_ID=your-messaging-service-id
MIXPANEL_PROJECT_TOKEN=your-mixpanel-token
MIXPANEL_API_SECRET=your-mixpanel-api-secret
MIXPANEL_PROJECT_ID=123456
MIXPANEL_USERNAME=your-mixpanel-username

# AI Service Configuration
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT=5s
AI_SERVICE_MAX_RETRIES=3
AI_SERVICE_CIRCUIT_BREAKER_THRESHOLD=5
AI_SERVICE_CIRCUIT_BREAKER_TIMEOUT=60
AI_SERVICE_CIRCUIT_BREAKER_INTERVAL=10
AI_SERVICE_CIRCUIT_BREAKER_MAX_REQUESTS=3
AI_SERVICE_FAILURE_RATE_THRESHOLD=0.5

# Observability Settings
OTEL_EXPORTER_OTLP_ENDPOINT=tempo:4317
ENVIRONMENT=local

# Feature Flags (optional)
ENABLE_SWAGGER=true