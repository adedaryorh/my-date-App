{
  "expo": {
    "name": "Celebut",
    "slug": "celebut",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/celebut-icon.png",
    "scheme": "celebut",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/celebut-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/images/celebut-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/celebut-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E3A5F",
          "image": "./assets/images/celebut-splash.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Celebut uses your location only while you use Nearby or submit a celebration. Your precise location is never shown to other people."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
