# Environment Variables Template for Celebut Application
# Copy this file to .env and fill in your actual values

# ============ DATABASE ============
POSTGRES_USER=celebut
POSTGRES_PASSWORD=celebut_password
POSTGRES_DB=celebut

# ============ REDIS ============
# REDIS_URI is set in docker-compose.yml as redis://redis:6379

# ============ RABBITMQ ============
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ============ APPLICATION ============
APP_ENV=local
APP_HOST=0.0.0.0
PORT=7070
GIN_MODE=debug

# ============ JWT ============
JWT_SECRET=your-super-secret-key-change-in-production-in-production
JWT_SECRET_EXPIRY=24h

# ============ AWS/S3 ============
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=celebut-bucket

# ============ EMAIL/SMS ============
SEND_GRID_API_KEY=your-sendgrid-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_ID=your-messaging-service-sid

# ============ ANALYTICS ============
MIX_PANEL_PROJECT_TOKEN=your-mixpanel-token
MIX_PANEL_API_SECRET=your-mixpanel-api-secret
MIX_PANEL_USERNAME=your-mixpanel-username
MIX_PANEL_PROJECT_ID=your-mixpanel-project-id

# ============ AI SERVICE ============
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT=5s
AI_SERVICE_MAX_RETRIES=3
AI_SERVICE_CIRCUIT_BREAKER_THRESHOLD=5
AI_SERVICE_CIRCUIT_BREAKER_TIMEOUT=60
AI_SERVICE_CIRCUIT_BREAKER_INTERVAL=10
AI_SERVICE_CIRCUIT_BREAKER_MAX_REQUESTS=3
AI_SERVICE_FAILURE_RATE_THRESHOLD=0.5

# ============ MONITORING ============
OTEL_EXPORTER_OTLP_ENDPOINT=tempo:4317